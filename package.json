{
  "name": "cotedi-project.github.io",
  "version": "1.0.0",
  "description": "Site Generator for the CoTEDI Project",
  "main": "",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "eslint src/; stylelint 'scss/**/*.scss' --allow-empty-input",
    "lint:fix": "eslint src/ --fix ; stylelint scss/*.scss --fix",
    "css:compile": "sass --silence-deprecation mixed-decls --silence-deprecation color-functions --silence-deprecation import --silence-deprecation global-builtin --load-path node_modules --style compressed --source-map scss:assets/css/",
    "css:check": "sass --load-path node_modules --style compressed --source-map scss:assets/css/",
    "css:fonts": "cp -r node_modules/bootstrap-icons/font/fonts docs/assets/css/",
    "build": "eleventy",
    "watch:web": "eleventy --serve --watch",
    "watch:all": "eleventy --serve --watch",
    "all": "cp -r node_modules/bootstrap-icons/font/fonts docs/assets/css/; eleventy",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "CoTEDI Project and Contributors",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-img": "7.1.1",
    "@eslint/js": "9.37.0",
    "browserslist": "^4.29.5",
    "eslint": "^4.0.0",
    "globals": "16.4.0",
    "lightningcss": "^1.33.0",
    "npm-run-all": "^1.1.3",
    "sass": "1.93.2",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "39.0.1",
    "stylelint-config-standard-scss": "14.0.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "markdown-it-attrs": "5.0.1"
  }
}
