+}
+/* stylelint-disable no-duplicate-selectors -- refinements intentionally
+   layer on top of the base rules above */
+
+/* ==========================================================================
+   Readability & polish layer
+   Layout/spacing/typography refinements. Colours reuse the variables above.
+   ========================================================================== */
+
+$measure: 68ch;
+$radius-card: 0.75rem;
+
+:root {
+    scroll-behavior: smooth;
+}
+
+body {
+    line-height: 1.65;
+    text-wrap: pretty;
+}
+
+h1, h2, h3, h4 {
+    text-wrap: balance;
+    line-height: 1.2;
+}
+
+/* Visible keyboard focus everywhere */
+a:focus-visible,
+button:focus-visible,
+summary:focus-visible,
+.btn:focus-visible {
+    outline: 3px solid darken($primary-color, 12%);
+    outline-offset: 2px;
+    border-radius: 3px;
+}
+
+.skip-link:focus {
+    display: inline-block;
+    margin: .5rem;
+    padding: .5rem 1rem;
+    background: #ffffff;
+    border-radius: 0.375rem;
+}
+
+/* ---------- Brand / header ---------- */
+
+.site-brand {
+    gap: 1.25rem;
+
+    .brand-logo {
+        width: 120px;
+        height: 65px;
+        flex: 0 0 auto;
+    }
+
+    .brand-title {
+        font-size: clamp(1.05rem, 1.6vw + .6rem, 1.6rem);
+        font-weight: 600;
+        line-height: 1.25;
+    }
+
+    &:hover .brand-title {
+        color: darken($primary-color, 10%);
+    }
+}
+
+/* ---------- Navigation ---------- */
+
+.top-dropdown-nav-bar {
+    background-color: $primary-color;
+    border-radius: 0.5rem 0.5rem 0 0;
+    margin-top: 1.25rem;
+
+    .main-nav {
+        display: none;
+    }
+
+    .compact-nav {
+        display: block;
+    }
+
+    ul.main-nav li a {
+        display: inline-block;
+        padding: .35rem .85rem;
+        color: $primary-fg-color;
+        font-weight: 500;
+        font-size: 1.05rem;
+        text-decoration: none;
+        border-radius: 999px;
+        transition: background-color .15s ease-in-out;
+
+        &:hover {
+            background-color: rgb(255 255 255 / 22%);
+        }
+
+        &[aria-current="page"] {
+            background-color: #ffffff;
+            color: darken($primary-color, 18%);
+        }
+    }
+
+    details summary {
+        font-size: 1.2rem;
+    }
+}
+
+@include media-breakpoint-up(lg) {
+    .top-dropdown-nav-bar {
+        .main-nav {
+            display: flex;
+            flex-wrap: wrap;
+            gap: .25rem;
+        }
+
+        .compact-nav {
+            display: none;
+        }
+    }
+}
+
+/* ---------- Main content rhythm ---------- */
+
+main {
+    .container {
+        margin-top: 1.5rem;
+    }
+
+    h1 {
+        font-size: clamp(1.9rem, 1.2rem + 2vw, 2.75rem);
+        margin-bottom: 1rem;
+    }
+
+    /* comfortable line length for body copy */
+    .rsf-text {
+        > p,
+        > ul,
+        > ol,
+        > blockquote,
+        article > p,
+        article > ul {
+            max-width: $measure;
+        }
+
+        li, p {
+            font-size: clamp(1rem, .95rem + .25vw, 1.15rem);
+        }
+    }
+
+    /* remove the decorative icon noise in front of every heading link */
+    article {
+        h1::before,
+        h2 a::before,
+        h1 a::before {
+            content: none;
+        }
+    }
+}
+
+@include media-breakpoint-up(md) {
+    main .rsf-text {
+        li, p {
+            font-size: clamp(1rem, .95rem + .25vw, 1.15rem);
+        }
+    }
+}
+
+/* ---------- Article teasers (news, materials, reports) ---------- */
+
+main article {
+    padding: 1.25rem 1.25rem 1rem;
+    margin-bottom: 1.75rem;
+    background: #ffffff;
+    border: 1px solid rgb(0 0 0 / 8%);
+    border-radius: $radius-card;
+    box-shadow: 0 1px 2px rgb(0 0 0 / 4%);
+    transition: box-shadow .18s ease-in-out, transform .18s ease-in-out;
+
+    &:not(:last-of-type) {
+        border-bottom: 1px solid rgb(0 0 0 / 8%);
+    }
+
+    &:hover {
+        box-shadow: 0 .5rem 1.5rem rgb(0 0 0 / 9%);
+        transform: translateY(-2px);
+    }
+
+    h2 {
+        font-size: clamp(1.25rem, 1.05rem + .7vw, 1.6rem);
+        margin-bottom: .35rem;
+    }
+
+    .heroimage {
+        height: auto;
+        margin-bottom: 1rem;
+        border-radius: calc(#{$radius-card} - .25rem);
+        overflow: hidden;
+
+        img {
+            width: 100%;
+            max-height: 280px;
+            object-fit: cover;
+            object-position: center;
+        }
+    }
+
+    p.meta {
+        color: darken($footer-grey-400, 45%);
+        font-size: .95rem;
+        margin-bottom: .5rem;
+    }
+
+    /* keep teaser text readable */
+    > p {
+        max-width: $measure;
+    }
+}
+
+/* ---------- Home hero & call to action ---------- */
+
+.heroimage {
+    border-radius: $radius-card;
+    overflow: hidden;
+    height: clamp(12rem, 28vw, 22rem);
+}
+
+.audience-split {
+    margin-top: 2.5rem;
+    margin-bottom: .5rem;
+
+    .row {
+        row-gap: 1rem;
+    }
+
+    .audience-card {
+        display: flex;
+        flex-direction: column;
+        gap: .5rem;
+        align-items: flex-start;
+
+        h2 {
+            font-size: clamp(1.35rem, 1.1rem + .8vw, 1.75rem);
+            margin-bottom: 0;
+        }
+
+        p {
+            margin-bottom: .5rem;
+            max-width: 40ch;
+        }
+
+        .btn {
+            padding: .6rem 1.15rem;
+            font-weight: 500;
+            border-radius: 999px;
+        }
+    }
+}
+
+@include media-breakpoint-up(md) {
+    .audience-split .audience-card + .audience-card {
+        border-left: 1px solid rgb(0 0 0 / 8%);
+        padding-left: 2rem;
+    }
+}
+
+/* ---------- Home teaser cards ---------- */
+
+#highlights {
+    .col-md-4 {
+        display: flex;
+        flex-direction: column;
+    }
+
+    h2.h5 {
+        font-size: 1.05rem;
+        letter-spacing: .04em;
+        text-transform: uppercase;
+        color: darken($footer-grey-400, 45%);
+        margin-bottom: .6rem;
+    }
+
+    .card {
+        flex: 1 1 auto;
+        border: 1px solid rgb(0 0 0 / 8%);
+        border-radius: $radius-card;
+        overflow: hidden;
+        transition: box-shadow .18s ease-in-out, transform .18s ease-in-out;
+
+        &:hover {
+            box-shadow: 0 .5rem 1.5rem rgb(0 0 0 / 10%);
+            transform: translateY(-2px);
+        }
+
+        .card-body {
+            display: flex;
+            align-items: flex-start;
+        }
+
+        .card-title {
+            font-size: 1.05rem;
+            line-height: 1.35;
+            margin-bottom: 0;
+        }
+    }
+
+    > .row > div > a:last-child {
+        margin-top: .75rem;
+        font-weight: 500;
+        color: darken($primary-color, 10%);
+        text-decoration: none;
+
+        &:hover {
+            text-decoration: underline;
+        }
+    }
+}
+
+/* ---------- Pagination ---------- */
+
+.pagination {
+    margin-top: 2rem;
+
+    .page-link {
+        color: darken($primary-color, 12%);
+    }
+
+    .page-item.active .page-link {
+        background-color: $primary-color;
+        border-color: $primary-color;
+        color: $primary-fg-color;
+    }
+}
+
+/* ---------- Footers ---------- */
+
+footer.sponsors,
+footer.partners {
+    li {
+        margin-right: 1.5rem;
+        margin-bottom: .75rem;
+        vertical-align: middle;
+    }
+
+    p {
+        text-transform: uppercase;
+        letter-spacing: .06em;
+        font-size: .85rem;
+        margin-bottom: .75rem;
+    }
+}
+
+footer.contact {
+    h3 {
+        text-transform: uppercase;
+        letter-spacing: .05em;
+        font-size: .9rem;
+        margin-bottom: .75rem;
+    }
+}
+
+footer.legal {
+    background-color: $footer-grey-600;
+    padding: 1rem 0 1.5rem;
+    font-size: .9rem;
+
+    a {
+        color: darken($primary-color, 12%);
+        text-decoration: none;
+
+        &:hover {
+            text-decoration: underline;
+        }
+    }
+}
+
+/* Respect reduced-motion preferences */
+@media (prefers-reduced-motion: reduce) {
+    :root {
+        scroll-behavior: auto;
+    }
+
+    * {
+        transition: none !important;
+    }
+
+    main article:hover,
+    #highlights .card:hover {
+        transform: none;
+    }
+}
+
+/* Extra breathing room between stacked CTA blocks on small screens */
+.audience-split .audience-card + .audience-card {
+    margin-top: 1.5rem;
+}
+
+@include media-breakpoint-up(md) {
+    .audience-split .audience-card + .audience-card {
+        margin-top: 0;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+
+/* Landing page structure: primary actions, about, teasers            */
+
+/* ------------------------------------------------------------------ */
+
+.home-intro {
+    padding-block: 1.5rem 0.5rem;
+}
+
+.home-lead {
+    max-width: 60ch;
+    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.35rem);
+    line-height: 1.5;
+}
+
+.home-primary {
+    padding-block: 1.5rem 2rem;
+}
+
+.primary-panel {
+    display: flex;
+    flex-direction: column;
+    height: 100%;
+    padding: 1.5rem;
+    border: 1px solid rgb(0 0 0 / 8%);
+    border-radius: 0.75rem;
+    background-color: #ffffff;
+    box-shadow: 0 2px 10px rgb(0 0 0 / 6%);
+}
+
+.primary-panel h3 {
+    margin-bottom: 0.5rem;
+    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.75rem);
+}
+
+.primary-panel-head p {
+    max-width: 46ch;
+    margin-bottom: 1rem;
+}
+
+.primary-list {
+    margin-top: 1.25rem;
+    margin-bottom: 0;
+    border-top: 1px solid rgb(0 0 0 / 8%);
+}
+
+.primary-list li {
+    padding-block: 0.55rem;
+    border-bottom: 1px solid rgb(0 0 0 / 6%);
+}
+
+.primary-extra {
+    margin-top: 0.75rem;
+    margin-bottom: 0;
+}
+
+.home-about {
+    padding-block: 2rem;
+    background-color: rgb(0 0 0 / 3%);
+}
+
+.home-about h2 {
+    margin-bottom: 1rem;
+}
+
+.home-teasers {
+    padding-block: 2rem;
+}
+
+.teasers-head {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.5rem 1rem;
+    align-items: baseline;
+    justify-content: space-between;
+    margin-bottom: 1rem;
+}
+
+.home-teasers .card-img-top {
+    height: 160px;
+    object-fit: cover;
+}
+
+.teasers-extra {
+    margin-top: 1.25rem;
+    margin-bottom: 0;
+}
