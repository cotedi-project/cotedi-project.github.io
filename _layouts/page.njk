---
layout: index
---
{% if hero %}
<div class="container rsf-text">
    <div class="heroimage text-center">
    <img src="{{ hero | url }}" alt="{{ title or meta.title }} cover image" loading="lazy" decoding="async">
    </div>
</div>
{% endif %}
{% if title -%}
<div class="container rsf-text">
        <h1>{{ title or meta.title }}</h1>
</div>
{%- endif %}
<div class="container rsf-text">
    {{ content | safe }}
</div>