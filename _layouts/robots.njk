---
layout: index
---
<div class="container rsf-text">
  <h1>{{ title }}</h1>

  <div class="row g-4">
    {%- for post in collections.robot | reverse -%}
      <div class="col-12 col-md-6 col-lg-4">
        <article class="card h-100 shadow-sm">
          {%- if post.data.hero and post.data.hero != "No image available" -%}
            <a href="{{ post.url | url }}" tabindex="-1" aria-hidden="true">
              <img class="card-img-top podium-img" src="{{ post.url | url }}{{ post.data.hero | url }}" alt="{{ post.data.title }}" loading="lazy" decoding="async">
            </a>
          {%- endif -%}
          <div class="card-body d-flex flex-column">
            <h2 class="card-title h5">{{ post.data.title }}</h2>
            <p class="card-text">{{ post.data.description | striptags | truncate(160) }}</p>
            <a class="btn btn-outline-primary mt-auto align-self-start bi bi-box-arrow-up-right" href="{{ post.url | url }}"> Read more</a>
          </div>
        </article>
      </div>
    {%- endfor -%}
  </div>
</div>