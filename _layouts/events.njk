---
layout: index
---
    <div class="container rsf-text">
      {% if hero %}
          <div class="heroimage text-center">
          <img src="{{ hero | url }}" alt="{{ title }} cover image" loading="lazy" decoding="async">
          </div>
      {% endif %}
        <h1>{{ title }}</h1>
        <div class="content">
        {{ content | safe }}
        </div>
        <div class="tags">
          <ul>
            {% for tag in tags %}
                {% if tag != 'event' %}
              <li><a href="{{ '/tags/' + tag | slug }}">{{ tag }}</a></li>
                {% endif %}
            {% endfor %}
          </ul>
        </div>
{% if page.data.partner -%}
{% set allpartners = partners.research %}
{% set allpartners = allpartners.concat(partners.schools) %}
<div class="partner">
    {% for rpartner in allpartners %}
        {% if rpartner.acronym == page.data.partner %}
      <a href="{{ rpartner.url }}" target="_blank" rel="noopener"><img class="partner logo" src="/images/partners/{{rpartner.logo | url }}" alt="{{ rpartner.name }}"></a>
        {% endif %}
    {% endfor %}
</div>
{%- endif %}
