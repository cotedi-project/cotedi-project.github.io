---
layout: index
---
<div class="container rsf-text">
  <h1>{{ title }}</h1>

  {% set posts = collections.material | reverse %}

  {% set allpartners = partners.research %}
  {% set allpartners = allpartners.concat(partners.schools) %}

  <div class="row g-4 materials-grid">
    {% for post in posts %}
    <div class="col-12 col-md-4">
      <article class="card h-100 shadow-sm {{ post.data.type }}">

        {% if post.data.hero and post.data.hero != "No image available" %}
        <a href="{{ post.url | url }}" tabindex="-1" aria-hidden="true">
          <img src="{{ post.url | url }}{{ post.data.hero | url }}"
               class="card-img-top materials-thumb-img"
               alt="{{ post.data.title }} teaser image"
               sizes="(max-width: 768px) 100vw, 33vw"
               loading="lazy" decoding="async">
        </a>
        {% endif %}

        <div class="card-body">
          <h2 class="card-title h5">
            <a class="text-decoration-none" href="{{ post.url | url }}">{{ post.data.title }}</a>
          </h2>

          <p class="meta small text-muted mb-2">
            {%- if post.data.language and post.data.language != 'English'-%}{{ " " }}
              {%- set display_language = post.data.language -%}
              {%- if post.data.language == 'es_ES' -%}
                {%- set display_language = 'Spanish' -%}
              {%- endif -%}
              <span class="badge text-bg-warning">
                {%- if post.data.language == 'Spanish' -%}🇪🇸
                {%- elif post.data.language == 'es_ES' -%}🇪🇸
                {%- elif post.data.language == 'Portuguese' -%}🇵🇹
                {%- elif post.data.language == 'German' -%}🇩🇪
                {%- elif post.data.language == 'Dutch' -%}🇳🇱
                {%- elif post.data.language == 'Swedish' -%}🇸🇪
                {%- endif %} {{ display_language }} Content</span>
            {%- endif %}
            <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time> by
            <span>
              {%- for partner in allpartners -%}
                {%- for member in partner.team -%}
                  {%- if member.login == post.data.author -%}
                    {{ " " }}<span class="author">{{ member.name }}</span>
                  {%- elif member.name == post.data.author -%}
                    {{ " " }}<span class="author">{{ post.data.author }}</span>
                  {%- endif -%}
                {%- endfor -%}
              {%- endfor -%}

              {%- for collaborator in post.data.partner -%}
                {%- for partner in allpartners -%}
                  {%- for member in partner.team -%}
                    {%- if member.login == collaborator or member.name == collaborator or member.alias == collaborator -%}
                      {{ " " }}<span class="author">{{ member.name }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
              {%- endfor -%}
            </span>
          </p>

          <div class="card-text">{{ post.data.description | safe }}</div>
        </div>

        <div class="card-footer bg-transparent border-0 pt-0 pb-3">
          <a class="bi bi-box-arrow-up-right" href="{{ post.url | url }}"> Read more</a>
        </div>
      </article>
    </div>
    {% endfor %}
  </div>

  {% if pagination and pagination.hrefs.length > 1 %}
  <nav aria-label="Materials pagination" class="mt-4">
    <ul class="pagination justify-content-center">
      {% if pagination.href.previous %}
        <li class="page-item"><a class="page-link" href="{{ pagination.href.previous | url }}">Previous</a></li>
      {% endif %}
      {% for href in pagination.hrefs %}
        <li class="page-item {% if loop.index0 == pagination.pageNumber %}active{% endif %}">
          <a class="page-link" href="{{ href | url }}">{{ loop.index }}</a>
        </li>
      {% endfor %}
      {% if pagination.href.next %}
        <li class="page-item"><a class="page-link" href="{{ pagination.href.next | url }}">Next</a></li>
      {% endif %}
    </ul>
  </nav>
  {% endif %}
</div>