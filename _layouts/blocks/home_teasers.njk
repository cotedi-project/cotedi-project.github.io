{% set latestNews = collections.news | reverse | entryLimit(3) %}

<section id="highlights" class="container home-teasers" aria-labelledby="teasers-heading">
  <div class="teasers-head">
    <h2 id="teasers-heading" class="h4">Latest news</h2>
    <a href="{{ '/news/' | url }}">All news »</a>
  </div>

  <div class="row g-4">
    {% for item in latestNews %}
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        {% if item.data.hero and item.data.hero != "No image available" %}
        <img src="{{ item.url | url }}{{ item.data.hero | url }}" class="card-img-top" alt="{{ item.data.title }}">
        {% endif %}
        <div class="card-body">
          <h3 class="card-title h6"><a class="stretched-link text-decoration-none" href="{{ item.url | url }}">{{ item.data.title }}</a></h3>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>

  <p class="teasers-extra"><a href="{{ '/events/' | url }}">Upcoming events »</a></p>
</section>
